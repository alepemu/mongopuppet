{
  "name": "mongopuppet",
  "version": "0.2.0",
  "description": "Interactive CLI to backup, restore and purge MongoDB databases",
  "type": "module",
  "bin": {
    "mongopuppet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci . && tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mongodb",
    "mongodump",
    "mongorestore",
    "cli",
    "backup"
  ],
  "license": "MIT",
  "author": "alepemu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepemu/mongopuppet.git"
  },
  "homepage": "https://github.com/alepemu/mongopuppet#readme",
  "bugs": {
    "url": "https://github.com/alepemu/mongopuppet/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.5",
    "@inquirer/prompts": "^8.7.3",
    "conf": "^16.0.0",
    "execa": "^10.2.0",
    "mongodb": "^7.7.0",
    "picocolors": "^1.1.1"
  }
}
