{
  "name": "mongopuppet",
  "version": "0.0.1",
  "description": "Interactive CLI to backup, restore and purge MongoDB databases",
  "type": "module",
  "bin": {
    "mongopuppet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci . && tsc --noEmit"
  },
  "keywords": [
    "mongodb",
    "mongodump",
    "mongorestore",
    "cli",
    "backup"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "conf": "^16.0.0",
    "execa": "^10.2.0",
    "mongodb": "^7.7.0",
    "picocolors": "^1.1.1"
  }
}
